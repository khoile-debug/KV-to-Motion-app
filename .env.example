# Sao chép thành .env rồi điền. Chỉ cần key của dịch vụ bạn dùng.
# Mô hình đọc ảnh (phân tích KV, mẫu chuyển động, viết lời thoại)
ANTHROPIC_API_KEY=
# TTS — chọn nhà cung cấp: espeak | google | openai | elevenlabs | fpt | azure | command
KV_TTS_PROVIDER=espeak
KV_TTS_VOICE=vi
GOOGLE_TTS_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
FPT_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
